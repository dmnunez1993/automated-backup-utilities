#!/usr/bin/env python3
import copy
import os
import subprocess
import sys

import yaml
from dotenv import load_dotenv

APP_IMAGE_NAME = 'automated_backup_utilities'
DEFAULT_COMPOSE_NAME = 'automated_backup_utilities_prod'

IMAGE_NAMES = [
    APP_IMAGE_NAME,
]

LOCAL_INPUT_CONTAINER_BASE = '/local_inputs'
OVERRIDE_FILE = 'docker-compose.override.yml'
DOCKER_CONFIG_PATH = '/tmp/config.docker.yaml'
GENERATED_OVERRIDE_HEADER = '# Generated by automated-backup-utilities deployer.\n'


def kubernetes_config_paths(config):
    """Return host kubeconfig paths, preserving KUBECONFIG merge order."""
    explicit_path = config.get('kubeconfig')
    if explicit_path:
        return [explicit_path]
    config_dir = os.environ.get('KUBE_CONFIG_DIR')
    if config_dir:
        return [os.path.join(config_dir, 'config')]
    return [path for path in os.environ.get('KUBECONFIG', '').split(os.pathsep)
            if path] or ['~/.kube/config']


def get_compose_name():
    compose_name = os.environ.get('COMPOSE_NAME', DEFAULT_COMPOSE_NAME)
    return compose_name


def get_compose():
    for command in (['docker', 'compose'], ['docker-compose']):
        try:
            version = subprocess.check_output(
                command + ['version', '--short'], stderr=subprocess.DEVNULL)
        except (OSError, subprocess.CalledProcessError):
            continue
        return command, version.strip().lstrip(b'v').startswith(b'1.')
    raise SystemExit('Docker Compose is required. Make docker compose or '
                     'docker-compose available on this host.')


def run_command(command):
    subprocess.call(command, shell=True)


def get_repo_root():
    command = ['git', 'rev-parse', '--show-toplevel']
    if sys.version_info < (3, 6):
        return subprocess.check_output(command).decode('utf-8').strip()
    return subprocess.check_output(command, encoding='utf-8').strip()


def generate_override(repo_root, config_path, legacy_compose=False):
    """Read config.yaml, remap local and Kubernetes paths for Docker, and write
    docker-compose.override.yml with the required volume mounts.
    Returns True if an override was generated, False otherwise.
    """
    with open(config_path, 'r', encoding='utf-8') as f:
        configs = yaml.safe_load(f)

    modified_configs = copy.deepcopy(configs)
    extra_volumes = []
    environment = {'CONFIG_PATH': DOCKER_CONFIG_PATH}
    kube_directories = {}

    def mount_kubeconfig(host_path):
        host_path = os.path.expanduser(os.path.expandvars(host_path))
        if not os.path.isabs(host_path):
            host_path = os.path.join(repo_root, host_path)
        host_path = os.path.abspath(host_path)
        if not os.path.isfile(host_path):
            raise FileNotFoundError('Kubeconfig file not found: {}'.format(host_path))
        directory = os.path.dirname(host_path)
        if directory not in kube_directories:
            container_directory = '/kube/{}'.format(len(kube_directories))
            kube_directories[directory] = container_directory
            mount = {
                'type': 'bind',
                'source': directory,
                'target': container_directory,
                'read_only': True,
            }
            if not legacy_compose:
                mount['bind'] = {'create_host_path': False}
            extra_volumes.append(mount)
        return '{}/{}'.format(kube_directories[directory], os.path.basename(host_path))

    for config in modified_configs:
        if config.get('type') == 'local':
            name = config['name']
            host_path = config['local']['path']
            container_path = '{}/{}'.format(LOCAL_INPUT_CONTAINER_BASE, name)
            extra_volumes.append('{}:{}'.format(host_path, container_path))
            config['local']['path'] = container_path

        if config.get('type') == 'kubernetes':
            kubernetes = config['kubernetes']
            paths = [mount_kubeconfig(path)
                     for path in kubernetes_config_paths(kubernetes)]
            if kubernetes.get('kubeconfig'):
                kubernetes['kubeconfig'] = paths[0]
            else:
                environment['KUBECONFIG'] = ':'.join(paths)

    if not extra_volumes:
        override_path = os.path.join(repo_root, OVERRIDE_FILE)
        if os.path.isfile(override_path):
            with open(override_path, 'r', encoding='utf-8') as f:
                generated = f.readline() == GENERATED_OVERRIDE_HEADER
            if generated:
                os.remove(override_path)
        return False

    # Write the modified config to /tmp so the already-mounted /tmp volume
    # makes it available inside the container without an extra mount.
    host_docker_config = DOCKER_CONFIG_PATH
    with open(host_docker_config, 'w', encoding='utf-8') as f:
        yaml.dump(modified_configs, f, default_flow_style=False)

    override = {
        'services':
            {
                'backup_utilities':
                    {
                        'environment': environment,
                        'volumes': extra_volumes,
                    }
            }
    }

    override_path = os.path.join(repo_root, OVERRIDE_FILE)
    with open(override_path, 'w', encoding='utf-8') as f:
        f.write(GENERATED_OVERRIDE_HEADER)
        yaml.dump(override, f, default_flow_style=False)

    print(
        'Generated {} with {} volume mount(s).'.format(OVERRIDE_FILE, len(extra_volumes))
    )
    return True


def main():
    command = sys.argv[1]

    repo_root = get_repo_root()
    # Exported values (including direnv's .envrc values) take precedence.
    load_dotenv(os.path.join(repo_root, '.env'), override=False)
    app_dockerfile_path = os.path.join(
        repo_root,
        'Dockerfile',
    )

    if command == 'build':
        print("Building services...")

        run_command(
            'cd {} && docker build -f {} -t {}:latest .'.format(
                repo_root, app_dockerfile_path, APP_IMAGE_NAME)
        )

    if command == 'push':
        registry = sys.argv[2]

        for image_name in IMAGE_NAMES:
            run_command(
                'docker tag {image}:latest {registry}/{image}'.format(
                    image=image_name, registry=registry)
            )
            run_command('docker push {}/{}'.format(registry, image_name))

    if command == 'pull':
        registry = sys.argv[2]

        for image_name in IMAGE_NAMES:
            run_command('docker pull {}/{}'.format(registry, image_name))
            run_command(
                'docker tag {registry}/{image} {image}:latest'.format(
                    registry=registry, image=image_name)
            )

    compose_actions = {
        'deploy': ('Deploying services...', ['up', '-d']),
        'start': ('Starting services...', ['up']),
        'stop': ('Stopping services...', ['stop']),
        'shell': ('Starting up shell...', ['run', 'backup_utilities', 'sh']),
    }
    if command in compose_actions:
        compose, legacy_compose = get_compose()
        message, arguments = compose_actions[command]
        print(message)
        # Compose treats a bare filename in the volume source as a named volume.
        config_path = os.path.abspath(os.environ.get('CONFIG_PATH') or
                                      os.path.join(repo_root, 'config.yaml'))
        if command in ('deploy', 'start'):
            generate_override(repo_root, config_path, legacy_compose=legacy_compose)
        environment = dict(os.environ, CONFIG_PATH=config_path)
        return subprocess.call(compose + ['-p', get_compose_name()] + arguments,
                               env=environment)


if __name__ == '__main__':
    sys.exit(main())
